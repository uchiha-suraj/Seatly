{
  "name": "@seatly/api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "build": "node scripts/build.mjs",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "typecheck": "tsc -p tsconfig.json",
    "seed": "tsx --env-file-if-exists=../../.env scripts/seed.ts",
    "db:check": "tsx --env-file-if-exists=../../.env scripts/db-check.ts",
    "demo:reset": "tsx --env-file-if-exists=../../.env scripts/demo-reset.ts",
    "demo:concurrency": "tsx --env-file-if-exists=../../.env scripts/concurrency-demo.ts",
    "demo:idempotency": "tsx --env-file-if-exists=../../.env scripts/idempotency-demo.ts"
  },
  "dependencies": {
    "@seatly/shared": "*",
    "argon2": "^0.45.1",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "mongoose": "^9.10.3",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "esbuild": "^0.28.2",
    "supertest": "^7.3.0",
    "tsx": "^4.23.15"
  }
}
