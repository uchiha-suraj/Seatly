# Copy to .env (never commit .env). Values below are for local development.
NODE_ENV=development
PORT=4000
# Single-node replica set from docker-compose.yml. Transactions need ?replicaSet=rs0.
MONGODB_URI=mongodb://localhost:27017/seatly?replicaSet=rs0
APP_ORIGIN=http://localhost:5173
COOKIE_SECURE=false
TRUST_PROXY=0
SESSION_IDLE_MINUTES=120
SESSION_ABSOLUTE_DAYS=7
BOOKING_DEADLINE_MS=4000
IDEMPOTENCY_LEASE_MS=15000
IDEMPOTENCY_TTL_HOURS=24
AUTH_RATE_LIMIT_PER_MIN=10
ARGON2_MEMORY_KIB=65536
# true only locally: allows `npm run demo:*` to reset the demo event and disables the auth rate limit.
DEMO_MODE=false
SERVE_WEB_DIST=false
LOG_LEVEL=info
# Integration tests use their own databases (seatly_test_<worker>) on this server.
MONGODB_URI_TEST=mongodb://localhost:27017/?replicaSet=rs0
